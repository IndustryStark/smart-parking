[Unit]
Description=Smart Parking (RFID entrance, spot sensors, web UI)
After=network.target

[Service]
User=@APP_USER@
SupplementaryGroups=gpio spi
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/smartparking.env
Environment=PARKING_DB=@APP_DIR@/data/parking.db
Environment=PYTHONUNBUFFERED=1
ExecStart=@APP_DIR@/venv/bin/python run.py --real --port 5000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
